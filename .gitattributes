# Normaliza finales de línea.
* text=auto eol=lf
*.png binary
*.zip binary

# Archivos de desarrollo excluidos del paquete instalable
# (bin/build-zip.sh y la descarga ZIP de GitHub usan git archive).
# README.md y SKILL.md NO se excluyen aquí: los importadores de skills
# (p. ej. LobeHub) descargan el ZIP de GitHub y necesitan SKILL.md.
# bin/build-zip.sh los quita del paquete del plugin.
/.github            export-ignore
/bin                export-ignore
/tests              export-ignore
/.editorconfig      export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/composer.json      export-ignore
/composer.lock      export-ignore
/phpcs.xml.dist     export-ignore
